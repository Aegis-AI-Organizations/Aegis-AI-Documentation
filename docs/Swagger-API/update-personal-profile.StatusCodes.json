{
  "responses": {
    "200": {
      "description": "Profile updated",
      "content": {
        "application/json": {
          "schema": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "format": "uuid" },
              "email": { "type": "string", "format": "email" },
              "name": { "type": "string" },
              "role": {
                "type": "string",
                "enum": [
                  "superadmin",
                  "admin",
                  "billing_aegis",
                  "technicien",
                  "support",
                  "owner",
                  "billing_client",
                  "operateur",
                  "viewer"
                ],
                "title": "UserRole"
              },
              "company_id": { "type": "string", "format": "uuid" },
              "avatar_url": { "type": "string", "nullable": true }
            },
            "title": "User"
          }
        }
      }
    }
  }
}
