{
  "responses": {
    "200": {
      "description": "Full scan details retrieved",
      "content": {
        "application/json": {
          "schema": {
            "type": "object",
            "required": ["id", "status", "target_image"],
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid",
                "description": "Unique platform scan identifier"
              },
              "temporal_workflow_id": {
                "type": "string",
                "description": "Internal Temporal orchestration ID"
              },
              "target_image": {
                "type": "string",
                "description": "The target Docker image/endpoint (e.g. nginx:latest)"
              },
              "status": {
                "type": "string",
                "enum": [
                  "PENDING",
                  "PROVISIONING",
                  "SCANNING",
                  "ANALYZING",
                  "FINISHED",
                  "FAILED"
                ]
              },
              "started_at": {
                "type": "string",
                "format": "date-time",
                "description": "ISO timestamp of scan initialization"
              },
              "completed_at": {
                "type": "string",
                "format": "date-time",
                "nullable": true,
                "description": "ISO timestamp of scan completion"
              }
            },
            "title": "Scan"
          }
        }
      }
    },
    "404": { "description": "Scan ID not found in database" }
  }
}
