{
  "responses": {
    "200": {
      "description": "Successfully authenticated",
      "content": {
        "application/json": {
          "schema": {
            "type": "object",
            "properties": {
              "access_token": { "type": "string" },
              "expires_in": {
                "type": "integer",
                "description": "Seconds until expiration"
              },
              "token_type": { "type": "string", "example": "Bearer" }
            },
            "title": "AuthResponse"
          }
        }
      }
    },
    "401": {
      "description": "Invalid credentials",
      "content": {
        "application/json": {
          "schema": {
            "type": "object",
            "properties": { "error": { "type": "string" } },
            "title": "ErrorResponse"
          }
        }
      }
    }
  }
}
